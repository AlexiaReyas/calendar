{
  "name": "privelifeof-reyas",
  "version": "2.0.0",
  "private": true,
  "description": "Calendrier personnel : budget, cours, sport et travail",
  "author": "Reyas",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "portable": "electron-builder --win portable --x64",
    "check": "node --check main.cjs && node --check app/app.js && node --check app/features.js"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.reyas.privelife",
    "productName": "privelifeof_reyas",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "privelifeof_reyas-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "privelifeof_reyas-Portable-${version}.${ext}"
    }
  }
}